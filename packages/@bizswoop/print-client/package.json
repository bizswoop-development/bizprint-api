{
	"name": "@bizswoop/print-client",
	"license": "MIT",
	"version": "2.0.0",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./*.js": {
			"import": {
				"types": "./dist/*.d.ts",
				"default": "./dist/*.js"
			},
			"require": {
				"types": "./dist/*.d.cts",
				"default": "./dist/*.cjs"
			}
		},
		"./_virtual/*": null,
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test",
		"test": "vitest run",
		"test:unit": "vitest run test/unit",
		"test:smoke": "npm run build && node test/smoke/node-esm.mjs && node test/smoke/node-cjs.cjs",
		"prepublishOnly": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit && npm run test:smoke",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"axios-mock-adapter": "^2.1.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.93.0",
		"tsdown": "^0.23.7",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"axios": "^1.21.1"
	},
	"imports": {
		"#@/*": "./src/*",
		"#~/*": "./*"
	}
}
